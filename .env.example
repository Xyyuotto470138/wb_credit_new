# Copy this file to .env and fill in only what you need. .env is ignored by git. Never commit keys.
#
# Nothing here is needed to run the app, open the saved Keppel REIT paper or run the tests:
# those use saved drafts and the offline mock provider and make no outside call.

# REQUIRED ONLY FOR LIVE MODEL CALLS (drafting a section, an update proposal, a model sense check).
# Claude is called directly at Anthropic; the drafting model is set in config/models.yaml (fable-5-2-direct).
# Get a key at https://console.anthropic.com/ under API keys. Every call costs money and is logged in
# runtime/costs/ledger.jsonl. A full ES draft is roughly USD 15 to 20.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# A key alone does nothing. Live calls also need the app started with the live flag:
#   scripts/demo/serve.sh --keppel --live        (sets WB_CREDIT_LIVE=1 for that run)
# Do not put WB_CREDIT_LIVE in this file: keep live runs a deliberate choice each time.

# NOT USED TODAY. The model registry lists other routes (GPT direct at OpenAI, other models through
# OpenRouter) but they are switched off in config/models.yaml, so these keys are not read.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional: write the cost ledger somewhere else (default runtime/costs/ledger.jsonl).
# WB_CREDIT_LEDGER=
